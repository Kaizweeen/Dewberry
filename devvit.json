{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "dewberry",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Dewberry: force a new day",
        "description": "Close the current day and post the next one now",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/new-day"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "scheduler": {
    "tasks": {
      "daily": {
        "endpoint": "/internal/cron/daily",
        "cron": "0 12 * * *"
      }
    }
  }
}
